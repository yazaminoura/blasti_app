APP_NAME=BLASTI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_safar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAIL_CONTACT_ADDRESS=contact@example.com

# Public contact details shown in the footer and on the contact page (replace with the real ones)
SAFAR_TELEPHONE="+212 5 00 00 00 00"
SAFAR_EMAIL=contact@blasti.ma
SAFAR_ADRESSE="Casablanca, Maroc"

# Social links in the footer (leave empty to hide the icon)
SAFAR_FACEBOOK=
SAFAR_INSTAGRAM=
SAFAR_TIKTOK=
SAFAR_X=
SAFAR_LINKEDIN=

# Cancellation: a client can cancel online until N hours before departure

# CMI card payment (leave empty to disable card payment; test gateway by default)
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# Demo data loaded by "php artisan migrate" on an empty database (false to start with an empty site)
DEMO_DATA=true

# Legal notice (pages /legal/mentions-legales, CGV, confidentialité): empty = "à compléter"
SAFAR_SOCIETE=
SAFAR_FORME=
SAFAR_CAPITAL=
SAFAR_RC=
SAFAR_ICE=
SAFAR_IF=
SAFAR_DIRECTEUR_PUBLICATION=
SAFAR_HEBERGEUR=
SAFAR_CNDP=

# Booking rules (defaults in config/safar.php)
SAFAR_MAX_SIEGES=6
SAFAR_MODIFICATION_HEURES=48
SAFAR_MAX_NON_PAYES=4
SAFAR_NON_PAYES_PAR_MOIS=2
SAFAR_GUICHET_CORRECTION_MINUTES=30
SAFAR_ABSENCES_MAX=2
SAFAR_CONFIRMATION_PRESENCE=true
SAFAR_CONFIRMATION_DEMANDE_HEURES=24
SAFAR_CONFIRMATION_LIMITE_HEURES=24
SAFAR_CONFIRMATION_PAIEMENT_HEURES=36
SAFAR_POPUP_SECONDES=40
# local PC without CMI keys: fake card payment page (never used when APP_ENV is not "local")
SAFAR_PAIEMENT_TEST=true
# Return trip discount (%), agency payment deadline (hours), platform commission in the sales dashboard (%)
SAFAR_REMISE_RETOUR=10
SAFAR_AGENCE_DELAI_HEURES=24
SAFAR_COMMISSION=10
